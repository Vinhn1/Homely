<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- NÚT BACK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/btn_back_bg"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="Quay lại"/>

        </LinearLayout>

        <!-- ICON KHOÁ -->
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#0B4FCC"
            app:cardElevation="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="20dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/white"/>

        </androidx.cardview.widget.CardView>

        <!-- TIÊU ĐỀ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quên mật khẩu?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#071E5B"/>

        <!-- MÔ TẢ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="Nhập email của bạn, chúng tôi sẽ gửi\nliên kết đặt lại mật khẩu"
            android:textSize="14sp"
            android:textColor="#6B7BB5"
            android:gravity="center"
            android:lineSpacingExtra="3dp"/>

        <!-- STEP INDICATOR -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:gravity="center">

            <!-- Step 1: active -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:background="#0B4FCC"
                android:layout_marginEnd="4dp"/>

            <!-- Step 2: inactive -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:background="#C5CEE8"
                android:layout_marginEnd="4dp"/>

            <!-- Step 3: inactive -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:background="#C5CEE8"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Bước 1/3 — Nhập email"
            android:textSize="11sp"
            android:textColor="#8A9BC4"
            android:letterSpacing="0.05"/>

        <!-- INPUT EMAIL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_forgot_email"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Địa chỉ email"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_selector"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="#FFFFFF"
            app:hintTextColor="#0B4FCC"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="#8A9BC4"
            app:startIconMinSize="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_register_email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="textEmailAddress"
                android:textSize="15sp"
                android:textColor="#1A1A1A"
                android:paddingStart="40dp"
                android:background="@android:color/transparent"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- GỢI Ý -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_info"
                app:tint="#8A9BC4"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dùng email bạn đã đăng ký tài khoản"
                android:textSize="12sp"
                android:textColor="#8A9BC4"/>

        </LinearLayout>

        <!-- NÚT GỬI -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_reset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="Gửi liên kết đặt lại"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="#0B4FCC"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <!-- PROGRESS BAR -->
        <ProgressBar
            android:id="@+id/progressBarForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminateTint="#0B4FCC"
            android:visibility="gone"/>

        <!-- DIVIDER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D0D8F0"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:text="Hoặc"
                android:textSize="13sp"
                android:textColor="#8A9BC4"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D0D8F0"/>
        </LinearLayout>

        <!-- CARD HƯỚNG DẪN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không nhận được email?"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#071E5B"
                    android:layout_marginBottom="10dp"/>

                <!-- Gợi ý 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:text="1"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/step_circle_bg"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kiểm tra thư mục Spam hoặc Junk"
                        android:textSize="13sp"
                        android:textColor="#4A5568"/>
                </LinearLayout>

                <!-- Gợi ý 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:text="2"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/step_circle_bg"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chờ vài phút rồi thử lại"
                        android:textSize="13sp"
                        android:textColor="#4A5568"/>
                </LinearLayout>

                <!-- Gợi ý 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:text="3"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/step_circle_bg"
                        android:layout_marginEnd="10dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đảm bảo email nhập đúng chính tả"
                        android:textSize="13sp"
                        android:textColor="#4A5568"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- LINK QUAY LẠI ĐĂNG NHẬP -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#0B4FCC"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tv_back_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quay lại đăng nhập"
                android:textSize="14sp"
                android:textColor="#0B4FCC"
                android:textStyle="bold"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="120dp" />

    </LinearLayout>
</ScrollView>