<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F0F4FF">

    <!-- ── PHẦN ẢNH CỐ ĐỊNH (không scroll) ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:id="@+id/fl_image_header">

        <!-- ViewPager2 ảnh phòng -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_images"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Gradient phía dưới ảnh để toolbar dễ nhìn -->
<!--        <View-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="56dp"-->
<!--            android:layout_gravity="top"-->
<!--            android:background="@drawable/splash_background" />-->

        <!-- Toolbar: nút back + yêu thích -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_gravity="top"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="#FFFFFF"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/iv_favorite"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_heart"
                android:tint="#FFFFFF"/>
        </androidx.appcompat.widget.Toolbar>

        <!-- Indicator chấm tròn -->
        <LinearLayout
            android:id="@+id/ll_indicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"/>

        <!-- Số ảnh "1/5" -->
        <TextView
            android:id="@+id/tv_image_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#66000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"/>

    </FrameLayout>

    <!-- ── PHẦN NỘI DUNG SCROLL (bên dưới ảnh) ── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="280dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="16dp">

            <!-- CARD: Thông tin chính -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Badge + Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tv_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đã xác thực"
                            android:textSize="10sp"
                            android:textColor="#0B4FCC"
                            android:background="@drawable/bg_badge_blue"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <!-- Bind từ code: "● Còn trống" / "● Đã cho thuê" -->
                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="#2E7D32"/>

                    </LinearLayout>

                    <!-- Nút sửa/xóa — chỉ hiện với chủ bài, ẩn mặc định -->
                    <LinearLayout
                        android:id="@+id/ll_owner_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btn_edit"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Chỉnh sửa"
                            android:textSize="13sp"
                            android:textColor="#0B4FCC"
                            android:backgroundTint="#EEF2FF"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_add_circle"
                            app:iconTint="#0B4FCC"/>

                        <Button
                            android:id="@+id/btn_delete"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Xóa bài"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#E53935"
                            app:cornerRadius="8dp"/>

                    </LinearLayout>

                    <!-- Bind từ code -->
                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text=""
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#071E5B"
                        android:lineSpacingMultiplier="1.2"/>

                    <!-- Bind từ code -->
                    <TextView
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text=""
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#E53935"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="10dp"
                        android:background="#F0F4FF"/>

                    <!-- Diện tích + Loại + Ngày đăng -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_house"
                                android:tint="#0B4FCC"/>

                            <!-- Bind từ code -->
                            <TextView
                                android:id="@+id/tv_area"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#071E5B"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diện tích"
                                android:textSize="11sp"
                                android:textColor="#8A9BC4"/>
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="40dp" android:background="#F0F4FF"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_building"
                                android:tint="#0B4FCC"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Phòng trọ"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#071E5B"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loại"
                                android:textSize="11sp"
                                android:textColor="#8A9BC4"/>
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="40dp" android:background="#F0F4FF"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_info"
                                android:tint="#0B4FCC"/>

                            <!-- Bind từ code -->
                            <TextView
                                android:id="@+id/tv_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#071E5B"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ngày đăng"
                                android:textSize="11sp"
                                android:textColor="#8A9BC4"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD: Địa chỉ + Bản đồ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="Địa chỉ"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#071E5B"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_location"
                            android:tint="#0B4FCC"/>

                        <!-- Bind từ code -->
                        <TextView
                            android:id="@+id/tv_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="#3D5A99"/>
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/iv_map_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/placeholder_room"/>

                        <LinearLayout
                            android:id="@+id/ll_open_map"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#33000000"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_location"
                                android:tint="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Mở Google Maps"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD: Mô tả -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="Mô tả"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#071E5B"/>

                    <!-- Bind từ code, mặc định 4 dòng -->
                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="#3D5A99"
                        android:lineSpacingMultiplier="1.5"
                        android:maxLines="4"
                        android:ellipsize="end"/>

                    <!-- Hiện khi text > 4 dòng -->
                    <TextView
                        android:id="@+id/tv_read_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Xem thêm"
                        android:textSize="13sp"
                        android:textColor="#0B4FCC"
                        android:textStyle="bold"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD: Tiện ích -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="Tiện ích"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#071E5B"/>

                    <!-- Chip tiện ích thêm động từ code -->
                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/flexbox_amenities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:flexWrap="wrap"
                        app:flexDirection="row"
                        app:alignItems="flex_start"
                        app:justifyContent="flex_start"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD: Đánh giá -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Đánh giá"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#071E5B"/>

                        <TextView
                            android:id="@+id/tv_add_review"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Viết đánh giá"
                            android:textSize="13sp"
                            android:textColor="#0B4FCC"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <!-- Bind từ code -->
                        <TextView
                            android:id="@+id/tv_rating_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="#071E5B"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Bind từ code: ratingBar.setRating() -->
                            <RatingBar
                                android:id="@+id/rating_bar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:numStars="5"
                                android:isIndicator="true"
                                android:stepSize="0.5"
                                style="?android:attr/ratingBarStyleSmall"/>

                            <!-- Bind từ code -->
                            <TextView
                                android:id="@+id/tv_review_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="#8A9BC4"/>
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                    <TextView
                        android:id="@+id/tv_all_reviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Xem tất cả đánh giá →"
                        android:textSize="13sp"
                        android:textColor="#0B4FCC"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD: Chủ trọ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Thông tin chủ trọ"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#071E5B"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp">

                            <!-- Bind từ code (Glide) -->
                            <ImageView
                                android:id="@+id/iv_landlord_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_user"/>
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Bind từ code: user.getName() -->
                            <TextView
                                android:id="@+id/tv_landlord_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#071E5B"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chủ trọ"
                                android:textSize="12sp"
                                android:textColor="#8A9BC4"/>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_chat"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Nhắn tin"
                            android:textSize="13sp"
                            android:textColor="#0B4FCC"
                            android:backgroundTint="#EEF2FF"
                            app:cornerRadius="8dp"/>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2 nút hành động — cuối trang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <!-- Enable/disable từ code sau khi load User.getPhone() -->
                <Button
                    android:id="@+id/btn_call"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Gọi điện"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:backgroundTint="#0B4FCC"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_phone"
                    app:iconTint="@color/white"
                    app:iconPadding="6dp"/>

                <Button
                    android:id="@+id/btn_contact"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Nhắn tin"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_chat"
                    android:textColor="@color/white"
                    android:backgroundTint="#0B4FCC"
                    app:cornerRadius="12dp"
                    app:iconPadding="6dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>